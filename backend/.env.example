PORT=5000
# Make this a long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=30m
# Frontend addresses allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:5000,http://localhost:5000,http://127.0.0.1:5500
# First admin account, created automatically only when the users table is empty
ADMIN_NAME=Mall Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Strong-123

# Link used inside password-reset emails (change to your real domain when deployed)
APP_URL=http://localhost:5000
# Optional email sending. Leave SMTP_HOST empty in development: the reset link is printed in the server terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
